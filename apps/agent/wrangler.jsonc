{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iris-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The sandbox classes need Node.js APIs.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Where the Worker is served: the OAuth issuer, and `/api` under it is the one resource its
    // tokens are for. `pnpm dev` overrides it with the local https origin.
    "ORIGIN": "https://iris-agent.marrromugi-dev.workers.dev",
    // The R2 bucket agents' /workspace lives in, through its S3 API.
    "S3_ENDPOINT": "https://4c813ed706774fd910c89f9bd3ba9a09.r2.cloudflarestorage.com",
    "S3_BUCKET": "iris-workspaces",
    // Whose model every agent thinks with: "anthropic" (Claude, through ANTHROPIC_API_KEY) or
    // "workers-ai" (the AI binding).
    "MODEL_PROVIDER": "anthropic",
  },
  // S3_*: an R2 API token for that bucket only, with Object Read & Write. The Worker signs storage
  // requests with it; containers never see it. ANTHROPIC_API_KEY: the Claude API key.
  "secrets": { "required": ["S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "ANTHROPIC_API_KEY"] },
  // Each agent's sandbox: a container with no internet, its image built from sandbox/Dockerfile.
  "containers": [
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": { "workspace": { "dockerfile": "./sandbox/Dockerfile" } },
    },
  ],
  "ai": { "binding": "AI" },
  // The Worker writes under agents/<agentId>/ in it, which a sandbox shows at /workspace. Must
  // name the same bucket as S3_BUCKET, which the sandboxes mount.
  "r2_buckets": [{ "binding": "WORKSPACES", "bucket_name": "iris-workspaces" }],
  // Browser Run: each run's browser for the browser tools.
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "USER_AGENT", "class_name": "UserAgent" },
      { "name": "AGENT_SANDBOX", "class_name": "AgentSandbox" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentSandbox"] },
  ],
  // Users, their passkeys, and invites: what sign-in reads across users.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iris",
      "database_id": "0799ab4b-f110-40a1-a3c9-278726eb3e53",
      "migrations_dir": "d1-migrations",
    },
  ],
  // The OAuth provider's clients, grants and tokens, and passkey ceremonies (namespace iris-oauth).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "957e7e8c065c4e62b82f94650c60f4cf" }],
  "ratelimits": [
    {
      "name": "SIGN_IN_RATE_LIMIT",
      // Workers in one account that use the same namespace_id share counters, so this one is iris's alone.
      "namespace_id": "51617",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "dev": { "port": 8787 },
  // Drizzle migrations import their .sql files as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // The sign-in page inlines its browser script, bundled from src/sign-in/client.
  "build": { "command": "pnpm run build:client", "watch_dir": "src" },
}
