{
  "openapi": "3.1.0",
  "info": {
    "title": "iris",
    "version": "1",
    "description": "A user's agents, which they can add, and their threads: each agent's one-to-one thread and groups of agents. In a thread the user sends posts, and the members named with @, or all of them when none is, reply with runs; an agent's scheduled tasks also start runs in its one-to-one thread. /api/agents/{agentId}/messages, runs and events work on the agent's one-to-one thread. Errors are { message }, except 401, which comes from the OAuth layer. GET /api/threads/{threadId}/events with a WebSocket upgrade opens a socket that sends the thread's posts, its runs as they change, and how the one being carried on is getting on (RunEvent); /api/agents/{agentId}/events does the same for the agent's one-to-one thread without posts."
  },
  "servers": [
    {
      "url": "https://iris-agent.marrromugi-dev.workers.dev"
    }
  ],
  "security": [
    {
      "iris": []
    }
  ],
  "components": {
    "securitySchemes": {
      "iris": {
        "type": "oauth2",
        "description": "Sign in through the sheet at /authorize with resource set to the /api URL, using PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/authorize",
            "tokenUrl": "/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "RunEvent": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "run"
                ]
              },
              "run": {
                "$ref": "#/components/schemas/Run"
              }
            },
            "required": [
              "type",
              "run"
            ],
            "description": "A run started, got a message, or ended or failed an attempt: the run as it is now"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "progress"
                ]
              },
              "runId": {
                "type": "string",
                "format": "uuid"
              },
              "progress": {
                "$ref": "#/components/schemas/RunProgress"
              }
            },
            "required": [
              "type",
              "runId",
              "progress"
            ],
            "description": "How a run being carried on is getting on. A socket that opens during a run hears the latest at once. Writing comes at most every 100 ms; the run's next run event has the whole message."
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "post"
                ]
              },
              "post": {
                "$ref": "#/components/schemas/Post"
              }
            },
            "required": [
              "type",
              "post"
            ],
            "description": "A post was sent in the thread. Only a socket opened at /api/threads/{threadId}/events hears these; the runs that reply to it follow as run events"
          }
        ],
        "description": "One event on the WebSocket at /api/threads/{threadId}/events, or at /api/agents/{agentId}/events for the agent's one-to-one thread without posts, which the app opens with the same token as /api. The server sends these as JSON text; the app sends nothing. Nothing is sent about what happened before the socket opened, apart from the progress of a run being carried on: open the socket, then read the runs."
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "agentId": {
            "type": "string",
            "format": "uuid",
            "description": "The agent it is a run of"
          },
          "taskId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The task that started it; null when a post did"
          },
          "postId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The post it replies to, which is also its first message; null when a task started it"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "failedAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "required": [
          "id",
          "agentId",
          "taskId",
          "postId",
          "startedAt",
          "endedAt",
          "lastError",
          "failedAttempts",
          "messages"
        ]
      },
      "Message": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "assistant"
                ]
              },
              "parts": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "text"
                          ]
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "tool-call"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input": {
                          "description": "The tool's input: any JSON value"
                        }
                      },
                      "required": [
                        "type",
                        "id",
                        "name"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "role",
              "parts"
            ]
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "tool"
                ]
              },
              "callId": {
                "type": "string",
                "minLength": 1
              },
              "isError": {
                "type": "boolean"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "callId",
              "isError",
              "content"
            ]
          }
        ]
      },
      "RunProgress": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "starting"
                ]
              }
            },
            "required": [
              "type"
            ],
            "description": "The run was picked up"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "thinking"
                ]
              }
            },
            "required": [
              "type"
            ],
            "description": "The model is asked, and hasn't written anything of this message yet"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "writing"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "description": "The model is writing; text is the message so far"
          }
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "agentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The agent that asked it in a consult; null when the user said it"
          },
          "text": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "agentId",
          "text",
          "createdAt"
        ],
        "description": "What was said in a thread: by the user, or in a consult by the agent that asked"
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The name the user's invite gave them"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "look": {
            "$ref": "#/components/schemas/Look"
          },
          "lastRanAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When its latest run started; null until it first runs"
          }
        },
        "required": [
          "id",
          "name",
          "look",
          "lastRanAt"
        ]
      },
      "Look": {
        "type": "object",
        "properties": {
          "palette": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "required": [
          "palette",
          "seed"
        ],
        "description": "How an agent's orb is drawn: one of the app's palettes, taken modulo how many the app has, and the seed of its noise"
      },
      "NewAgent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "look": {
            "$ref": "#/components/schemas/Look"
          }
        },
        "required": [
          "name"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prompt": {
            "type": "string"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string",
                "minLength": 1
              },
              "timeZone": {
                "type": "string"
              }
            },
            "required": [
              "cron",
              "timeZone"
            ]
          },
          "nextRunAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "prompt",
          "schedule",
          "nextRunAt"
        ]
      },
      "NewTask": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string",
                "minLength": 1
              },
              "timeZone": {
                "type": "string"
              }
            },
            "required": [
              "cron",
              "timeZone"
            ]
          }
        },
        "required": [
          "prompt",
          "schedule"
        ]
      },
      "NewMessage": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ]
      },
      "Thread": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The group's name, or the agent's in its one-to-one thread"
          },
          "agentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The agent whose one-to-one thread this is; null for a group"
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The members, in the order they were added as agents"
          },
          "lastActivityAt": {
            "type": "string",
            "format": "date-time",
            "description": "When it was made, a post was sent, or a run started, whichever came last"
          }
        },
        "required": [
          "id",
          "name",
          "agentId",
          "agentIds",
          "lastActivityAt"
        ]
      },
      "NewGroup": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 2
          }
        },
        "required": [
          "name",
          "agentIds"
        ]
      },
      "ThreadEntry": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "post"
                ]
              },
              "post": {
                "$ref": "#/components/schemas/Post"
              }
            },
            "required": [
              "type",
              "post"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "run"
                ]
              },
              "run": {
                "$ref": "#/components/schemas/Run"
              }
            },
            "required": [
              "type",
              "run"
            ]
          }
        ],
        "description": "A post or a run of a thread"
      },
      "SentPost": {
        "type": "object",
        "properties": {
          "post": {
            "$ref": "#/components/schemas/Post"
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Run"
            }
          }
        },
        "required": [
          "post",
          "runs"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): refresh, or sign in again. The body is empty; with a token, WWW-Authenticate says error=\"invalid_token\" (RFC 6750)."
          },
          "403": {
            "description": "The token names no user, or one that no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agents": {
      "get": {
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "The user's agents in the order they were added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agent"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): refresh, or sign in again. The body is empty; with a token, WWW-Authenticate says error=\"invalid_token\" (RFC 6750)."
          },
          "403": {
            "description": "The token names no user, or one that no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addAgent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewAgent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The agent added, last in the list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): refresh, or sign in again. The body is empty; with a token, WWW-Authenticate says error=\"invalid_token\" (RFC 6750)."
          },
          "403": {
            "description": "The token names no user, or one that no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body isn't sent as application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agents/{agentId}/tasks": {
      "get": {
        "operationId": "listTasks",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "agentId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The agent's tasks, the next to run first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): refresh, or sign in again. The body is empty; with a token, WWW-Authenticate says error=\"invalid_token\" (RFC 6750)."
          },
          "403": {
            "description": "The token names no user, or one that no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No agent of this user has this ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addTask",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "agentId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The task added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): refresh, or sign in again. The body is empty; with a token, WWW-Authenticate says error=\"invalid_token\" (RFC 6750)."
          },
          "403": {
            "description": "The token names no user, or one that no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No agent of this user has this ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "The body isn't sent as application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something went wrong on the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agents/{agentId}/tasks/{taskId}": {
      "delete": {
        "operationId": "removeTask",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "agentId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "taskId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Removed. Runs it already started carry on."
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): refresh, or sign in again. The body is empty; with a token, WWW-Authenticate says error=\"invalid_token\" (RFC 6750)."
          },
          "403": {
            "description": "The token names no user, or one that no longer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No agent of this user has this ID, or No task of this agent has this ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
