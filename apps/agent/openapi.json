{
  "openapi": "3.1.0",
  "info": {
    "title": "iris",
    "version": "1",
    "description": "A user's scheduled tasks and their runs. Errors are { message }, except 401, which comes from the OAuth layer."
  },
  "servers": [
    {
      "url": "https://iris-agent.marrromugi-dev.workers.dev"
    }
  ],
  "security": [
    {
      "iris": []
    }
  ],
  "components": {
    "securitySchemes": {
      "iris": {
        "type": "oauth2",
        "description": "Sign in through the sheet at /authorize with resource set to the /api URL, using PKCE.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/authorize",
            "tokenUrl": "/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prompt": {
            "type": "string"
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string",
                "minLength": 1
              },
              "timeZone": {
                "type": "string"
              }
            },
            "required": [
              "cron",
              "timeZone"
            ]
          },
          "nextRunAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "prompt",
          "schedule",
          "nextRunAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "NewTask": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string",
                "minLength": 1
              },
              "timeZone": {
                "type": "string"
              }
            },
            "required": [
              "cron",
              "timeZone"
            ]
          }
        },
        "required": [
          "prompt",
          "schedule"
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "taskId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "failedAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          }
        },
        "required": [
          "id",
          "taskId",
          "startedAt",
          "endedAt",
          "lastError",
          "failedAttempts",
          "messages"
        ]
      },
      "Message": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user"
                ]
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "assistant"
                ]
              },
              "parts": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "text"
                          ]
                        },
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "tool-call"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input": {
                          "description": "The tool's input: any JSON value"
                        }
                      },
                      "required": [
                        "type",
                        "id",
                        "name"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "role",
              "parts"
            ]
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "tool"
                ]
              },
              "callId": {
                "type": "string",
                "minLength": 1
              },
              "isError": {
                "type": "boolean"
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "callId",
              "isError",
              "content"
            ]
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/tasks": {
      "get": {
        "operationId": "listTasks",
        "responses": {
          "200": {
            "description": "The user's tasks, the next to run first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): sign in again. The body is empty without a token, and { error, error_description } (RFC 6750) with one."
          },
          "403": {
            "description": "The token names no user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The task added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): sign in again. The body is empty without a token, and { error, error_description } (RFC 6750) with one."
          },
          "403": {
            "description": "The token names no user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{taskId}": {
      "delete": {
        "operationId": "removeTask",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "taskId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Removed. Runs it already started carry on."
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): sign in again. The body is empty without a token, and { error, error_description } (RFC 6750) with one."
          },
          "403": {
            "description": "The token names no user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No task of this user has this ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "operationId": "recentRuns",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The user's latest runs first, each with its conversation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request doesn't fit the API; the message says why",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or one not valid for /api (expired, revoked, or for another resource): sign in again. The body is empty without a token, and { error, error_description } (RFC 6750) with one."
          },
          "403": {
            "description": "The token names no user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
